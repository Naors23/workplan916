rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'naorsadi@gmail.com';
    }

    // Logged in user
    function isLoggedIn() {
      return request.auth != null;
    }

    // Authorized user — admin OR email exists in allowedUsers list
    function isAllowed() {
      return isAdmin() || (request.auth != null &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)));
    }

    // Own sync code doc (USER_<uid>) or admin — AND must be authorized
    function isOwnWorkplan(docId) {
      return isAllowed() && (isAdmin() || docId == ('USER_' + request.auth.uid));
    }

    // Workplans - each user accesses only their own doc
    match /workplans/{docId} {
      allow read, write: if isLoggedIn() && isOwnWorkplan(docId);
    }

    // Allowed users list - only admin manages it; a user may check their own entry
    match /allowedUsers/{email} {
      allow read: if isAdmin() || (isLoggedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Legacy collections - admin only (not actively used by app)
    match /tasks/{docId} {
      allow read, write: if isAdmin();
    }

    match /fixedTasks/{docId} {
      allow read, write: if isAdmin();
    }

    match /events/{docId} {
      allow read, write: if isAdmin();
    }

    match /completedInstances/{docId} {
      allow read, write: if isAdmin();
    }

    match /notDoneInstances/{docId} {
      allow read, write: if isAdmin();
    }

    // Shared tasks - any authorized user can read (for import feature) and write
    match /sharedTasks/{docId} {
      allow read: if isAllowed();
      allow write: if isAllowed();
    }

    // Users - user can write own doc, only admin can read all
    match /users/{userId} {
      allow write: if isLoggedIn() && request.auth.uid == userId;
      allow read: if isAdmin() || (isLoggedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Unit settings - user can read/write own (must be authorized)
    match /userSettings/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    // Schedule items - user can read/write own (must be authorized)
    match /scheduleItems/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    // Notes - user can read/write own (must be authorized)
    match /notes/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
