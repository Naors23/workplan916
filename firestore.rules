rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'naorsadi@gmail.com';
    }

    // Logged in user
    function isLoggedIn() {
      return request.auth != null;
    }

    // Own sync code doc (USER_<uid>) or admin
    function isOwnWorkplan(docId) {
      return isAdmin() || docId == ('USER_' + request.auth.uid);
    }

    // Workplans - each user accesses only their own doc
    match /workplans/{docId} {
      allow read, write: if isLoggedIn() && isOwnWorkplan(docId);
    }

    // Legacy collections - admin only (not actively used by app)
    match /tasks/{docId} {
      allow read, write: if isAdmin();
    }

    match /fixedTasks/{docId} {
      allow read, write: if isAdmin();
    }

    match /events/{docId} {
      allow read, write: if isAdmin();
    }

    match /completedInstances/{docId} {
      allow read, write: if isAdmin();
    }

    match /notDoneInstances/{docId} {
      allow read, write: if isAdmin();
    }

    // Shared tasks - any logged in user can read (for import feature), only owner can write
    match /sharedTasks/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // Users - user can write own doc, only admin can read all
    match /users/{userId} {
      allow write: if isLoggedIn() && request.auth.uid == userId;
      allow read: if isAdmin() || (isLoggedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Unit settings - user can read/write own
    match /userSettings/{userId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // Schedule items - user can read/write own
    match /scheduleItems/{userId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // Notes - user can read/write own
    match /notes/{userId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
